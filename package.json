{
  "name": "schola",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"vite,api\" -c \"cyan,magenta\" \"vite --host\" \"node --watch server/index.js\"",
    "dev:frontend": "vite --host",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "build:render": "npm install --include=dev && npm run build && cd server && npm install && npx playwright install chromium",
    "start": "node server/index.js",
    "postinstall": "cd server && npm install",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rnd": "^10.5.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0"
  }
}
